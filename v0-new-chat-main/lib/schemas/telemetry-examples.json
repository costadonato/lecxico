      ]
    },
    "game_attempts_table": {
      "table_name": "game_attempts",
      "columns": [
        { "name": "id", "type": "UUID", "primary_key": true },
        { "name": "session_id", "type": "UUID", "foreign_key": "game_sessions(id)" },
        { "name": "attempt_number", "type": "INTEGER" },
        { "name": "timestamp", "type": "TIMESTAMP" },
        { "name": "level", "type": "INTEGER" },
        { "name": "is_correct", "type": "BOOLEAN" },
        { "name": "time_to_answer", "type": "FLOAT" },
        { "name": "hint_used", "type": "BOOLEAN", "default": false },
        { "name": "content_id", "type": "VARCHAR(100)", "nullable": true },
        { "name": "user_response", "type": "TEXT", "nullable": true },
        { "name": "correct_response", "type": "TEXT", "nullable": true },
        { "name": "metadata", "type": "JSONB", "nullable": true },
        { "name": "created_at", "type": "TIMESTAMP", "default": "NOW()" }
      ],
      "indexes": [
